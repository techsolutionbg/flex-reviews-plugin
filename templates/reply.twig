<article id="flex-review-{{ answer.id }}" tabindex="-1" class="flex-review-answer{{ answer.is_store ? ' is-store' : '' }}"><header><span class="flex-review-avatar" aria-hidden="true">{{ answer.name|slice(0,1)|upper }}</span><div class="flex-review-author"><strong>{{ answer.name }} {% if answer.is_store %}<span class="flex-store-badge">От магазина</span>{% endif %}</strong><time datetime="{{ answer.created_at|date('Y-m-d') }}">{{ answer.created_at|date('d.m.Y') }}</time></div></header>{% if answer.parent_name %}<a class="flex-reply-context" href="#flex-review-{{ answer.parent_id }}" data-review-parent="{{ answer.parent_id }}">В отговор на {{ answer.parent_name }}</a>{% endif %}<p class="flex-review-body">{{ answer.body }}</p>{% if settings.user_replies %}<button type="button" class="flex-reply-button" data-reply-to="{{ answer.id }}" data-reply-name="{{ answer.name }}">Отговори</button>{% endif %}</article>
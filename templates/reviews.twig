<div class="flex-reviews" data-reviews-product="{{ product.id }}" data-user-replies="{{ settings.replies and settings.user_replies ? '1' : '0' }}" data-replies="{{ settings.replies ? '1' : '0' }}" data-guest-replies="{{ settings.guests and settings.guest_replies ? '1' : '0' }}">
<h2>Коментари за {{ product.name }}</h2>
<div data-reviews-list class="flex-review-list">{% for review in listing.records %}<article id="flex-review-{{ review.id }}" tabindex="-1" class="flex-review"><header><span class="flex-review-avatar" aria-hidden="true">{{ review.name|slice(0,1)|upper }}</span><div class="flex-review-author"><strong>{{ review.name }}</strong>{{ flex_time(review.created_at, 'date') }}</div>{% if review.rating %}<div class="flex-review-rating" role="img" aria-label="Оценка {{ review.rating }} от 5">{% for star in 1..5 %}<svg class="flex-review-star{{ star <= review.rating ? ' is-filled' : '' }}" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.78 5.63L21 9.54l-4.5 4.39 1.06 6.2L12 17.2l-5.56 2.93 1.06-6.2L3 9.54l6.22-.91L12 3Z"/></svg>{% endfor %}<span class="flex-review-rating-value">{{ review.rating }}<small>/5</small></span></div>{% endif %}</header><p class="flex-review-body">{{ review.body }}</p>{% if settings.replies %}{% if settings.user_replies %}<button type="button" class="flex-reply-button" data-reply-to="{{ review.id }}" data-reply-name="{{ review.name }}">Отговори</button>{% endif %}<div class="flex-review-thread" data-thread="{{ review.id }}" data-thread-page="1"><div data-thread-list>{% for answer in review.replies %}{% include 'reply.twig' %}{% endfor %}</div>{% if review.reply_count > review.replies|length %}<button type="button" class="flex-reply-more" data-thread-more="{{ review.id }}">Покажи още отговори ({{ review.reply_count - review.replies|length }})</button>{% endif %}</div>{% endif %}</article>{% else %}<p class="flex-review-empty">Все още няма коментари. Споделете своето мнение.</p>{% endfor %}</div>
<div class="flex-review-pagination" data-reviews-pagination></div>
<form data-reviews-form class="flex-review-form"><h3>Оставете коментар</h3><p>Имейлът ви няма да се показва публично.{% if settings.moderation %} Коментарите се публикуват след одобрение.{% endif %}{% if not settings.guests %} Необходим е вход в профила.{% endif %}</p>
<p class="flex-review-required-note">Полетата, отбелязани със <span class="flex-review-required" aria-hidden="true">*</span>, са задължителни.</p>
<div class="flex-review-fields"><label class="flex-field flex-label"><span>Име <span class="flex-review-required" aria-hidden="true">*</span><span class="flex-review-sr-only"> (задължително)</span></span><input class="flex-input" name="name" required maxlength="100" autocomplete="name"></label><label class="flex-field flex-label"><span>Имейл <span class="flex-review-required" aria-hidden="true">*</span><span class="flex-review-sr-only"> (задължително)</span></span><input class="flex-input" name="email" type="email" required maxlength="254" autocomplete="email"></label></div>
{% if settings.ratings %}<fieldset class="flex-rating-picker"><legend>Вашата оценка <small>по желание</small></legend><div class="flex-rating-controls"><div class="flex-rating-stars">{% for n in 1..5 %}<label class="flex-rating-option" title="{{ n }} от 5"><input type="radio" name="rating" value="{{ n }}" aria-label="{{ n }} от 5 звезди"><svg class="flex-review-star" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.78 5.63L21 9.54l-4.5 4.39 1.06 6.2L12 17.2l-5.56 2.93 1.06-6.2L3 9.54l6.22-.91L12 3Z"/></svg></label>{% endfor %}</div><span class="flex-rating-hint" data-rating-hint aria-live="polite">Изберете от 1 до 5 звезди</span><button type="button" class="flex-rating-clear" data-rating-clear hidden>Изчисти</button></div></fieldset>{% endif %}
<label class="flex-field flex-label"><span>Коментар <span class="flex-review-required" aria-hidden="true">*</span><span class="flex-review-sr-only"> (задължително)</span></span><textarea class="flex-input" name="body" required minlength="{{ settings.min_length }}" maxlength="{{ settings.max_length }}" rows="5"></textarea></label>
<label class="flex-review-trap" aria-hidden="true">Уебсайт<input name="website" tabindex="-1" autocomplete="off"></label>
{% if settings.notify_reply %}<label><span><input type="checkbox" name="notify_reply"> Искам известие по имейл при нов отговор в разговора.</span></label>{% endif %}
<button type="submit" class="flex-btn flex-btn--primary">Изпрати коментар</button><p role="status" aria-live="polite" data-reviews-status></p></form></div>


{
  "id": "flex/reviews",
  "name": "Flex Reviews",
  "version": "0.2.0",
  "description": "Коментари и оценки за продукти с модерация.",
  "minimum_platform_version": "0.1.62",
  "entrypoint": "Flex\\Reviews\\ReviewsPlugin",
  "autoload": {
    "Flex\\Reviews\\": "src/"
  },
  "permissions": [
    "admin.ui",
    "routes.admin",
    "routes.public",
    "frontend.assets"
  ],
  "frontend": {
    "scripts": [
      "assets/admin.js",
      "assets/reviews.js"
    ],
    "styles": [
      "assets/reviews.css"
    ],
    "public": {
      "groups": {
        "reviews": {
          "scripts": [
            "assets/reviews.js"
          ],
          "styles": [
            "assets/reviews.css"
          ]
        }
      }
    }
  },
  "metadata": {
    "storage": "database",
    "requires": [
      "flex/commerce"
    ]
  }
}
